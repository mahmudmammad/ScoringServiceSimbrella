{
  "id": null,
  "title": "Scoring Service Monitoring",
  "tags": ["scoring", "api", "monitoring"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Total Scoring Requests (Last 5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(scoring_requests_total[5m])",
          "legendFormat": "Total Requests",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Successful Scoring Requests (Last 5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(scoring_requests_successful_total[5m])",
          "legendFormat": "Successful",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Failed Scoring Requests (Last 5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(scoring_requests_failed_total[5m])",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Success Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "(scoring_requests_successful_total / scoring_requests_total) * 100",
          "legendFormat": "Success Rate (%)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "title": "Scoring Requests Rate (per minute)",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(scoring_requests_total[1m]) * 60",
          "legendFormat": "Total Requests/min",
          "refId": "A"
        },
        {
          "expr": "rate(scoring_requests_successful_total[1m]) * 60",
          "legendFormat": "Successful/min",
          "refId": "B"
        },
        {
          "expr": "rate(scoring_requests_failed_total[1m]) * 60",
          "legendFormat": "Failed/min",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "yAxes": [
        {
          "label": "Requests per minute",
          "show": true
        },
        {
          "show": true
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ]
    },
    {
      "id": 6,
      "title": "Condition Errors by Type",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(scoring_condition_errors_total[5m]) * 300",
          "legendFormat": "{{condition_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "yAxes": [
        {
          "label": "Errors per 5 minutes",
          "show": true
        },
        {
          "show": true
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ]
    },
    {
      "id": 7,
      "title": "Average Condition Evaluation Duration",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(scoring_condition_evaluation_seconds_sum[5m]) / rate(scoring_condition_evaluation_seconds_count[5m])",
          "legendFormat": "{{condition_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "yAxes": [
        {
          "label": "Duration (seconds)",
          "show": true
        },
        {
          "show": true
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ]
    },
    {
      "id": 8,
      "title": "95th Percentile Condition Evaluation Duration",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(scoring_condition_evaluation_seconds_bucket[5m]))",
          "legendFormat": "{{condition_name}} - 95th percentile",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "yAxes": [
        {
          "label": "Duration (seconds)",
          "show": true
        },
        {
          "show": true
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ]
    },
    {
      "id": 9,
      "title": "Total Condition Errors",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(scoring_condition_errors_total)",
          "legendFormat": "Total Errors",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Condition Evaluation Count by Type",
      "type": "stat",
      "targets": [
        {
          "expr": "scoring_condition_evaluation_seconds_count",
          "legendFormat": "{{condition_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Request Trends (Last 24h)",
      "type": "graph",
      "targets": [
        {
          "expr": "increase(scoring_requests_total[1h])",
          "legendFormat": "Total Requests/hour",
          "refId": "A"
        },
        {
          "expr": "increase(scoring_requests_successful_total[1h])",
          "legendFormat": "Successful/hour",
          "refId": "B"
        },
        {
          "expr": "increase(scoring_requests_failed_total[1h])",
          "legendFormat": "Failed/hour",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "yAxes": [
        {
          "label": "Requests per hour",
          "show": true
        },
        {
          "show": true
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "version": 1
}